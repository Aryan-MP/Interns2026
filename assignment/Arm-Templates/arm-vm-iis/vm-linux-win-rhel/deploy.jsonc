{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "osType": { 
      "type": "string", 
      "allowedValues": ["windows", "ubuntu", "centos"] 
    },
    "adminUsername": { "type": "string" },
    "adminPassword": { "type": "securestring" },
    "location": { "type": "string", "defaultValue": "centralindia" }
  },
  "variables": {
    "osMap": {
      "windows": {
        "vnetName": "vnet-win-isolated",
        "publisher": "MicrosoftWindowsServer",
        "offer": "WindowsServer",
        "sku": "2022-datacenter-azure-edition",
        "extPublisher": "Microsoft.Compute",
        "extType": "CustomScriptExtension",
        "extVersion": "1.10",
        "command": "powershell.exe Install-WindowsFeature -name Web-Server",
        "remotePort": "3389"
      },
      "ubuntu": {
        "vnetName": "vnet-ubuntu-isolated",
        "publisher": "Canonical",
        "offer": "0001-com-ubuntu-server-jammy",
        "sku": "22_04-lts-gen2",
        "extPublisher": "Microsoft.Azure.Extensions",
        "extType": "CustomScript",
        "extVersion": "2.1",
        "command": "apt-get update && apt-get install -y nginx",
        "remotePort": "22"
      },
      "centos": {
        "vnetName": "vnet-centos-isolated",
        "publisher": "OpenLogic",
        "offer": "CentOS-Stream",
        "sku": "9-stream-free-gen2",
        "extPublisher": "Microsoft.Azure.Extensions",
        "extType": "CustomScript",
        "extVersion": "2.1",
        "command": "dnf install -y nginx && systemctl enable --now nginx",
        "remotePort": "22"
      }
    },
    "selected": "[variables('osMap')[parameters('osType')]]",
    "vmName": "[concat('vishal-', parameters('osType'), '-vm')]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '-nsg')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "AllowHTTP",
            "properties": { "priority": 100, "access": "Allow", "direction": "Inbound", "protocol": "Tcp", "sourcePortRange": "*", "destinationPortRange": "80", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*" }
          },
          {
            "name": "AllowRemote",
            "properties": { "priority": 110, "access": "Allow", "direction": "Inbound", "protocol": "Tcp", "sourcePortRange": "*", "destinationPortRange": "[variables('selected').remotePort]", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*" }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('selected').vnetName]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": ["10.0.0.0/16"] },
        "subnets": [ { "name": "default", "properties": { "addressPrefix": "10.0.0.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('vmName'), '-nsg'))]" } } } ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '-pip')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '-nic')]",
      "location": "[parameters('location')]",
      "dependsOn": [ "[variables('selected').vnetName]", "[resourceId('Microsoft.Network/networkSecurityGroups', concat(variables('vmName'), '-nsg'))]" ],
      "properties": {
        "ipConfigurations": [ {
            "name": "ipconfig1",
            "properties": {
              "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('selected').vnetName, 'default')]" },
              "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('vmName'), '-pip'))]" }
            }
        } ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vmName'), '-nic'))]" ],
      "properties": {
        "hardwareProfile": { "vmSize": "Standard_D2s_v5" },
        "storageProfile": {
          "imageReference": {
            "publisher": "[variables('selected').publisher]",
            "offer": "[variables('selected').offer]",
            "sku": "[variables('selected').sku]",
            "version": "latest"
          }
        },
        "osProfile": {
          "computerName": "[substring(variables('vmName'), 0, 15)]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]"
        },
        "networkProfile": {
          "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', concat(variables('vmName'), '-nic'))]" } ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2023-09-01",
      "name": "[concat(variables('vmName'), '/SoftwareInstall')]",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.Compute/virtualMachines', variables('vmName'))]" ],
      "properties": {
        "publisher": "[variables('selected').extPublisher]",
        "type": "[variables('selected').extType]",
        "typeHandlerVersion": "[variables('selected').extVersion]",
        "settings": {
          "commandToExecute": "[variables('selected').command]"
        }
      }
    }
  ],
  "outputs": {
    "WebURL": { "type": "string", "value": "[concat('http://', reference(concat(variables('vmName'), '-pip')).ipAddress)]" }
  }
}