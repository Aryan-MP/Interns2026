{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "openAIName": {
      "type": "string",
      "defaultValue": "kiran-openai"
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    },
    "deploymentName": {
      "type": "string",
      "defaultValue": "gpt41mini"
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-04-01-preview",
      "name": "[parameters('openAIName')]",
      "location": "[parameters('location')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-04-01-preview",
      "name": "[concat(parameters('openAIName'), '/', parameters('deploymentName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('openAIName'))]"
      ],
      "sku": {
        "name": "Standard",
        "capacity": 10
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "gpt-4.1-mini",
          "version": "2025-04-14"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable"
      }
    }
  ],
  "outputs": {
    "endpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAIName'))).endpoint]"
    },
    "apiKey": {
      "type": "string",
      "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', parameters('openAIName')), '2024-04-01-preview').key1]"
    },
    "deploymentName": {
      "type": "string",
      "value": "[parameters('deploymentName')]"
    }
  }
}