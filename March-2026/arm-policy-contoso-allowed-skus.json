{
  "policies": [
    {
      "properties": {
        "displayName": "Contoso - Allow only B1s VM",
        "policyType": "Custom",
        "mode": "All",
        "description": "Deny any VM creation that is not Standard_B1s size.",
        "metadata": {
          "category": "Cost Management"
        },
        "parameters": {},
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachines"
              },
              {
                "not": {
                  "field": "Microsoft.Compute/virtualMachines/hardwareProfile.vmSize",
                  "equals": "Standard_B1s"
                }
              }
            ]
          },
          "then": {
            "effect": "deny"
          }
        }
      }
    },
    {
      "properties": {
        "displayName": "Contoso - Allow only Standard_LRS Storage Accounts",
        "policyType": "Custom",
        "mode": "All",
        "description": "Deny storage account SKUs except Standard_LRS.",
        "metadata": {
          "category": "Cost Management"
        },
        "parameters": {},
        "policyRule": {
          "if": {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Storage/storageAccounts"
              },
              {
                "not": {
                  "field": "Microsoft.Storage/storageAccounts/sku.name",
                  "equals": "Standard_LRS"
                }
              }
            ]
          },
          "then": {
            "effect": "deny"
          }
        }
      }
    }
  ]
}
