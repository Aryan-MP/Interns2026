{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "storageAccountName": {
      "type": "string"
    },
    "deploySecondaryStorage": {
      "type": "bool",
      "defaultValue": false
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },

  "variables": {
    "secondaryStorageName": "[concat(parameters('storageAccountName'), 'secondary')]"
  },

  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {}
    },

    {
      "condition": "[parameters('deploySecondaryStorage')]",
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('secondaryStorageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_GRS"
      },
      "kind": "StorageV2",
      "properties": {}
    }
  ]
}