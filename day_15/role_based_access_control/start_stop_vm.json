{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "principleID": {
            "type": "string",
            "defaultValue": "3f6e1f2c-7c32-4b6a-a1ad-8f27a3e5a9c1",
            "metedata": {
                "description": "You need to put your user Object ID"
            }
        }
    },
    "variables": {
        "customRoleName": "VM Operator",
        "customRoleID": "[guid(subscrption().id,variables('customRoleName'))]",
        "roleAssignmentName": "[guid(parameters('principleID'),variables('customRoleID'),subscrption().id)]"
    },
    "resources": [
        {
            "type": "Microsoft.Authorization/roleDefinations",
            "apiVersion": "2022-04-01",
            "name": "[variables('customRoleID')]",
            "properties": {
                "roleName": "[variables('customRoleName')]",
                "description": "Start, Stop and Read VM Only",
                "type": "CustomRole",
                "permission": [
                    {
                        "actions": [
                            "Microsoft.Compute/VirtualMachines/read",
                            "Microsoft.Compute/virtualMachines/start/action",
                            "Microsoft.Compute/VirtualMachines/deallocate/action"
                        ],
                        "notAction": []
                    }
                ],
                "assignableScopes": [
                    "[subscrption().id]"
                ]
            }
        },
        {
            "type": "Microsoft.Authorization/roleAssignment",
            "apiVersion": "2022-04-01",
            "name": "[variables('roleAssignmentName')]",
            "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleDefinations',variables('customRoleID'))]"
            ],
            "properties": {
                "roleDefinationId": "[subscrptionResourceID('Microsoft.Authorization/roleDefinations', variables('customRoleID'))]",
                "principleID": "[parameters('principleID')]"
            }
        }
    ],
    "outputs": {
        "customRoleName": {
            "type": "string",
            "value": "[variables('customRoleName')]"
        },
        "customRoleID": {
            "type": "string",
            "value": "[guid('Microsoft.Authorization/roleDefinations', variables('customRoleID'))]"
        },
        "roleAssignmentID": {
            "type": "string",
            "value": "[guid('Microsoft.Authorization/roleAssignment', variables('roleAssignmentName'))]"
        }
    }
}