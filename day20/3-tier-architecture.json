{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "4.0.0.0",
  "parameters": {
    "adminUsername": { "type": "string", "defaultValue": "azureadmin" },
    "adminPassword": { "type": "securestring", "defaultValue": "CloudArchitect@2026" },
    "location": { "type": "string", "defaultValue": "westus2" },
    "vmSize": { "type": "string", "defaultValue": "Standard_B2as_v2" },
    "vmCount": { "type": "int", "defaultValue": 2 }
  },
  "variables": {
    "vnetName": "ThreeTier-HA-VNet",
    "webNsgName": "Web-NSG",
    "appNsgName": "App-NSG",
    "dbNsgName": "DB-NSG",
    "webLbPipName": "Web-LB-PublicIP",
    "webVmPipNamePrefix": "Web-VM-PublicIP",
    "webLbName": "Web-Tier-LB",
    "appLbName": "App-Tier-Internal-LB",
    "natGwName": "ThreeTier-NAT-GW",
    "natGwPipName": "ThreeTier-NAT-PIP"
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2020-06-01",
      "name": "[variables('natGwPipName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" }
    },
    {
      "type": "Microsoft.Network/natGateways",
      "apiVersion": "2020-06-01",
      "name": "[variables('natGwName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "dependsOn": [ "[resourceId('Microsoft.Network/publicIPAddresses', variables('natGwPipName'))]" ],
      "properties": {
        "publicIpAddresses": [ { "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('natGwPipName'))]" } ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2020-06-01",
      "name": "[variables('webNsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          { "name": "Allow-HTTP-Internet", "properties": { "priority": 100, "protocol": "Tcp", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "80" } },
          { "name": "Allow-SSH-Internet", "properties": { "priority": 110, "protocol": "Tcp", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "22" } },
          { "name": "Allow-LB-HealthProbes", "properties": { "priority": 120, "protocol": "*", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "AzureLoadBalancer", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "*" } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2020-06-01",
      "name": "[variables('appNsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          { "name": "Allow-HTTP-From-Web", "properties": { "priority": 100, "protocol": "Tcp", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "10.0.1.0/24", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "80" } },
          { "name": "Allow-LB-HealthProbes", "properties": { "priority": 110, "protocol": "*", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "AzureLoadBalancer", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "*" } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2020-06-01",
      "name": "[variables('dbNsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          { "name": "Allow-MySQL-From-App", "properties": { "priority": 100, "protocol": "Tcp", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "10.0.2.0/24", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "3306" } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2020-06-01",
      "name": "[variables('webLbPipName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2020-06-01",
      "name": "[concat(variables('webVmPipNamePrefix'), '-', copyIndex())]",
      "copy": { "name": "webPipLoop", "count": "[parameters('vmCount')]" },
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": { "publicIPAllocationMethod": "Static" }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2020-06-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('webNsgName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsgName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('dbNsgName'))]",
        "[resourceId('Microsoft.Network/natGateways', variables('natGwName'))]"
      ],
      "properties": {
        "addressSpace": { "addressPrefixes": [ "10.0.0.0/16" ] },
        "subnets": [
          { "name": "Web-Subnet", "properties": { "addressPrefix": "10.0.1.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('webNsgName'))]" } } },
          { "name": "App-Subnet", "properties": { "addressPrefix": "10.0.2.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('appNsgName'))]" }, "natGateway": { "id": "[resourceId('Microsoft.Network/natGateways', variables('natGwName'))]" } } },
          { "name": "DB-Subnet", "properties": { "addressPrefix": "10.0.3.0/24", "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('dbNsgName'))]" }, "natGateway": { "id": "[resourceId('Microsoft.Network/natGateways', variables('natGwName'))]" } } }
        ]
      }
    },
    {
      "type": "Microsoft.Network/loadBalancers",
      "apiVersion": "2020-06-01",
      "name": "[variables('webLbName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "dependsOn": [ "[resourceId('Microsoft.Network/publicIPAddresses', variables('webLbPipName'))]" ],
      "properties": {
        "frontendIPConfigurations": [ { "name": "PublicFrontend", "properties": { "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('webLbPipName'))]" } } } ],
        "backendAddressPools": [ { "name": "WebBackendPool" } ],
        "probes": [ { "name": "HttpProbe", "properties": { "protocol": "Tcp", "port": 80, "intervalInSeconds": 15, "numberOfProbes": 2 } } ],
        "loadBalancingRules": [ { "name": "HttpRule", "properties": { "frontendIPConfiguration": { "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', variables('webLbName'), 'PublicFrontend')]" }, "backendAddressPool": { "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('webLbName'), 'WebBackendPool')]" }, "probe": { "id": "[resourceId('Microsoft.Network/loadBalancers/probes', variables('webLbName'), 'HttpProbe')]" }, "protocol": "Tcp", "frontendPort": 80, "backendPort": 80, "idleTimeoutInMinutes": 4 } } ]
      }
    },
    {
      "type": "Microsoft.Network/loadBalancers",
      "apiVersion": "2020-06-01",
      "name": "[variables('appLbName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "dependsOn": [ "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]" ],
      "properties": {
        "frontendIPConfigurations": [ { "name": "InternalFrontend", "properties": { "privateIPAllocationMethod": "Static", "privateIPAddress": "10.0.2.100", "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'App-Subnet')]" } } } ],
        "backendAddressPools": [ { "name": "AppBackendPool" } ],
        "probes": [ { "name": "HttpProbe", "properties": { "protocol": "Tcp", "port": 80, "intervalInSeconds": 15, "numberOfProbes": 2 } } ],
        "loadBalancingRules": [ { "name": "HttpRule", "properties": { "frontendIPConfiguration": { "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', variables('appLbName'), 'InternalFrontend')]" }, "backendAddressPool": { "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('appLbName'), 'AppBackendPool')]" }, "probe": { "id": "[resourceId('Microsoft.Network/loadBalancers/probes', variables('appLbName'), 'HttpProbe')]" }, "protocol": "Tcp", "frontendPort": 80, "backendPort": 80, "idleTimeoutInMinutes": 4 } } ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2020-06-01",
      "name": "[concat('Web-NIC-', copyIndex())]",
      "location": "[parameters('location')]",
      "copy": { "name": "webNicLoop", "count": "[parameters('vmCount')]" },
      "dependsOn": [ "webPipLoop", "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]", "[resourceId('Microsoft.Network/loadBalancers', variables('webLbName'))]" ],
      "properties": { "ipConfigurations": [ { "name": "ipconfig1", "properties": { "privateIPAllocationMethod": "Dynamic", "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses', concat(variables('webVmPipNamePrefix'), '-', copyIndex()))]" }, "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'Web-Subnet')]" }, "loadBalancerBackendAddressPools": [ { "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('webLbName'), 'WebBackendPool')]" } ] } } ] }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2020-06-01",
      "name": "[concat('App-NIC-', copyIndex())]",
      "location": "[parameters('location')]",
      "copy": { "name": "appNicLoop", "count": "[parameters('vmCount')]" },
      "dependsOn": [ "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]", "[resourceId('Microsoft.Network/loadBalancers', variables('appLbName'))]" ],
      "properties": { "ipConfigurations": [ { "name": "ipconfig1", "properties": { "privateIPAllocationMethod": "Dynamic", "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'App-Subnet')]" }, "loadBalancerBackendAddressPools": [ { "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('appLbName'), 'AppBackendPool')]" } ] } } ] }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2020-06-01",
      "name": "DB-NIC",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]" ],
      "properties": { "ipConfigurations": [ { "name": "ipconfig1", "properties": { "privateIPAllocationMethod": "Dynamic", "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'DB-Subnet')]" } } } ] }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2021-03-01",
      "name": "[concat('Web-Tier-VM-', copyIndex())]",
      "location": "[parameters('location')]",
      "copy": { "name": "webVmLoop", "count": "[parameters('vmCount')]" },
      "dependsOn": [ "webNicLoop" ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": { "computerName": "[concat('webvm', copyIndex())]", "adminUsername": "[parameters('adminUsername')]", "adminPassword": "[parameters('adminPassword')]", "customData": "[base64(concat('#!/bin/bash\napt-get update\napt-get install -y apache2\necho \"<h1 style=''color:blue;''>Tier 1: Web Layer (Behind Public LB) - SERVER ', copyIndex(), '</h1>\" > /var/www/html/index.html\nsystemctl restart apache2'))]" },
        "storageProfile": { "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" }, "osDisk": { "createOption": "FromImage" } },
        "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', concat('Web-NIC-', copyIndex()))]" } ] }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2021-03-01",
      "name": "[concat('App-Tier-VM-', copyIndex())]",
      "location": "[parameters('location')]",
      "copy": { "name": "appVmLoop", "count": "[parameters('vmCount')]" },
      "dependsOn": [ "appNicLoop" ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": { "computerName": "[concat('appvm', copyIndex())]", "adminUsername": "[parameters('adminUsername')]", "adminPassword": "[parameters('adminPassword')]", "customData": "[base64(concat('#!/bin/bash\napt-get update\napt-get install -y apache2\necho \"<h1 style=''color:green;''>Tier 2: App Layer (Behind Internal LB) - SERVER ', copyIndex(), '</h1>\" > /var/www/html/index.html\nsystemctl restart apache2'))]" },
        "storageProfile": { "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" }, "osDisk": { "createOption": "FromImage" } },
        "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', concat('App-NIC-', copyIndex()))]" } ] }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2021-03-01",
      "name": "DB-Tier-VM",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.Network/networkInterfaces', 'DB-NIC')]" ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "osProfile": { "computerName": "dbvm", "adminUsername": "[parameters('adminUsername')]", "adminPassword": "[parameters('adminPassword')]", "customData": "[base64('#!/bin/bash\napt-get update\napt-get install -y mysql-server\nsystemctl start mysql')]" },
        "storageProfile": { "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" }, "osDisk": { "createOption": "FromImage" } },
        "networkProfile": { "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', 'DB-NIC')]" } ] }
      }
    }
  ],
  "outputs": {
    "WebLoadBalancerURL": {
      "type": "string",
      "value": "[concat('http://', reference(resourceId('Microsoft.Network/publicIPAddresses', variables('webLbPipName'))).ipAddress)]"
    },
    "WebVM_0_SSH_Command": {
      "type": "string",
      "value": "[concat('ssh azureadmin@', reference(resourceId('Microsoft.Network/publicIPAddresses', concat(variables('webVmPipNamePrefix'), '-0'))).ipAddress)]"
    },
    "AppInternalLoadBalancerIP": {
      "type": "string",
      "value": "10.0.2.100"
    }
  }
}