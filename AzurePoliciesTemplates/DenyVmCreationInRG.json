{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "policyName": {
      "type": "string",
      "defaultValue": "deny-vm-in-rg",
      "metadata": {
        "description": "Name of the custom policy definition"
      }
    },
    "resourceGroupNameToAssign": {
      "type": "string",
      "metadata": {
        "description": "The resource group where this policy will be assigned"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyDefinitions",
      "apiVersion": "2021-06-01",
      "name": "[parameters('policyName')]",
      "properties": {
        "displayName": "Deny VM Creation in this Resource Group",
        "policyType": "Custom",
        "mode": "All",
        "description": "Prevents creation of Virtual Machines in the assigned Resource Group.",
        "metadata": {
          "category": "Compute",
          "version": "1.0.0"
        },
        "policyRule": {
          "if": {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          "then": {
            "effect": "deny"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2021-06-01",
      "name": "[concat(parameters('policyName'), '-assignment')]",
      "dependsOn": [
        "[resourceId('Microsoft.Authorization/policyDefinitions', parameters('policyName'))]"
      ],
      "properties": {
        "displayName": "Deny VM Creation Assignment",
        "policyDefinitionId": "[resourceId('Microsoft.Authorization/policyDefinitions', parameters('policyName'))]",
        "scope": "[resourceGroup(parameters('resourceGroupNameToAssign'))]"
      }
    }
  ]
}